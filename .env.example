# Пример .env — СКОПИРУЙ в .env и впиши реальные значения.
# Файл .env в .gitignore — НИКОГДА не коммить токены.

# ── Wildberries (один токен со всеми галочками, нужна «Продвижение») ──
WB_TOKEN=

# ── Ozon Seller API ──
OZON_CLIENT_ID=
OZON_API_KEY=

# ── Telegram-уведомления (опционально) ──
# Создать бота у @BotFather, получить токен; узнать chat_id у @userinfobot
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── Параметры автоматизации ──
LOW_STOCK_DAYS=14      # алерт, если запаса меньше N дней
MAX_DRR=20             # порог ДРР (%), выше — реклама неэффективна
APPLY_CHANGES=false    # true = реально менять (пауза рекламы и т.п.); false = только отчёт/алерт

# ── Платформа (мультиклиент) ──
# ИИ-слой (Claude API) на сервере
ANTHROPIC_API_KEY=
# Токены по клиентам (имена совпадают с реестром clients.yaml)
WB_TOKEN_KOROTICH=
OZON_CLIENT_ID_KOROTICH=
OZON_API_KEY_KOROTICH=
TG_CHAT_KOROTICH=
